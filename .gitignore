node_modules/
.env
.env.local
outputs/
data/
!lib/data/
!lib/data/*.ts
test-results/
playwright-report/
coverage/
coverage-all/
coverage-issue100/
reports/mutation/
.stryker-tmp/
*.log
.DS_Store
dist/
*.tsbuildinfo

# Runtime state (product): keep only the auditable savings ledger tracked
.simplicio/*
!.simplicio/ledger/
# Runtime state (agent operator, simplicio-loop convention)
# simplicio-loop >= 3.47 writes loop state (scratchpad, journal, anchor,
# last_response.txt transcripts) under .simplicio-loop/orchestrator/; only the
# installer's ownership receipt is tracked.
.simplicio-loop/*
!.simplicio-loop/install-ownership.json
# Legacy (< 3.47) operator state dir
.orchestrator/*

# Simplicio local runtime worktrees
.claude/worktrees/
!.orchestrator/savings/

# Python bytecode
__pycache__/
*.py[cod]
