    { "id": "out.post", "kind": "effect", "label": "Post agendado na rede (efeito externo, só com DRY_RUN=false)", "files": ["lib/publish/realoficial-browser.ts", "lib/publish/adaptlypost.ts"] },
    { "id": "out.ads", "kind": "effect", "label": "Anúncio pago (efeito externo, só com DRY_RUN=false)", "files": ["lib/publish/meta-ads.ts"] },
    { "id": "out.winners", "kind": "output", "label": "Vencedores e plano seguinte com variações", "files": ["lib/analytics/winners.ts"] },
    { "id": "out.learnings", "kind": "output", "label": "Aprendizados duráveis (learnings.jsonl)", "files": ["lib/promotion/learnings.ts"] },
    { "id": "out.report", "kind": "output", "label": "Relatório mensal em markdown e PDF", "files": ["lib/report/monthly.ts"] },
    { "id": "out.logs", "kind": "output", "label": "runs.jsonl, llm-usage.jsonl e eventos", "files": ["lib/observability/events.ts"] },
    { "id": "out.dashboard", "kind": "output", "label": "Painel local, alertas e página do cliente", "files": ["lib/dashboard/server.ts", "lib/dashboard/snapshot.ts"] }
