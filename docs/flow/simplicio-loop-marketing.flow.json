    { "id": "st.report", "kind": "step", "label": "Relatórios (peça e mês)", "files": ["lib/report/builder.ts", "lib/report/monthly.ts"], "commands": ["report"] },
    { "id": "st.dashboard", "kind": "step", "label": "Painel: fontes, regras de alerta e vistas somente leitura", "files": ["lib/observability/dashboard/index.ts", "lib/dashboard/alerts.ts", "lib/dashboard/server.ts"], "commands": ["dashboard"] },

    { "id": "out.piece", "kind": "output", "label": "Artefatos da peça: script, legendas, manifest.json", "files": ["lib/cli/generate.ts"] },
